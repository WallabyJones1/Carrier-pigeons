{
  "name": "carrier-pigeons-solana",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @carrier-pigeons/web",
    "dev:api": "npm run start -w @carrier-pigeons/api",
    "dev:worker": "npm run start -w @carrier-pigeons/worker",
    "build:web": "npm run build -w @carrier-pigeons/web",
    "test": "npm run test -w @carrier-pigeons/race-engine",
    "simulate": "node scripts/simulate-season.mjs",
    "metadata:generate": "node scripts/generate-metadata.mjs",
    "mint:setup": "node scripts/collection/setup-core-candy-machine.mjs",
    "mint:load": "node scripts/collection/load-items.mjs"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/mpl-core-candy-machine": "0.3.0",
    "@metaplex-foundation/umi": "1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "1.5.1"
  }
}
